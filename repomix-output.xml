<?php
declare(strict_types=1);

if (session_status() === PHP_SESSION_NONE) {
    // Enforce secure session cookie settings
    ini_set('session.cookie_httponly', '1');
    ini_set('session.use_strict_mode', '1');
    ini_set('session.cookie_samesite', 'Lax');
    
    session_start();
}

/**
 * Helper to determine application base path dynamically
 */
function basePath(string $path = ''): string
{
    // Adjust '/sesh' to your project root or define a BASE_PATH constant in config.php
    $base = '/sesh';
    return $base . '/' . ltrim($path, '/');
}

function requireLogin(): void
{
    if (!isset($_SESSION['user_id'])) {
        header('Location: ' . basePath('login.php'));
        exit;
    }
}

function requireRole(array $allowedRoles): void
{
    requireLogin();

    $role = $_SESSION['role'] ?? '';

    if (!in_array($role, $allowedRoles, true)) {
        header('Location: ' . basePath('unauthorized.php'));
        exit;
    }
}

function currentUser(): ?array
{
    if (!isset($_SESSION['user_id'])) {
        return null;
    }

    return [
        'id'        => (int) $_SESSION['user_id'],
        'full_name' => (string) ($_SESSION['full_name'] ?? ''),
        'email'     => (string) ($_SESSION['email'] ?? ''),
        'role'      => (string) ($_SESSION['role'] ?? ''),
    ];
}
