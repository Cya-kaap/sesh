$pendingFeedbackStmt = $pdo->prepare("
    SELECT b.id, b.date, r.name AS room_name
    FROM bookings b
    JOIN rooms r ON b.room_id = r.id
    LEFT JOIN room_feedback f ON f.booking_id = b.id
    WHERE b.user_id = :uid
      AND b.status = 'Completed'
      AND f.id IS NULL
    ORDER BY b.date DESC
");
