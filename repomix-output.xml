require_once __DIR__ . '/../includes/functions.php';

requireRole(['Faculty']);

$user = currentUser();

$stmt = $pdo->prepare("
    SELECT
        b.id, b.date, b.start_time, b.end_time, b.type, b.purpose, b.subject, b.status,
        r.name AS room_name, r.type AS room_type,
        p.name AS programme_name,
        s.number AS semester_number,
        f.id AS existing_feedback_id
    FROM bookings b
    JOIN rooms r        ON r.id = b.room_id
    JOIN programmes p   ON p.id = b.programme_id
    JOIN semesters s    ON s.id = b.semester_id
    LEFT JOIN room_feedback f ON f.booking_id = b.id
    WHERE b.user_id = :uid
    ORDER BY b.date DESC, b.start_time DESC
");
