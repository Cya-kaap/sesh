 */

/*
|--------------------------------------------------------------------------
| Schema Introspection
|--------------------------------------------------------------------------
*/

/**
 * Return the allowed values of a MySQL ENUM column.
 *
 * Used so dropdowns (room type, room status, etc.) always match the
 * actual database schema instead of a hardcoded, possibly-stale list.
 *
 * @param PDO    $pdo
 * @param string $table  Table name (must be alphanumeric/underscore only)
 * @param string $column Column name
 * @return string[] List of enum values, or [] if not an enum column
 */
function getEnumValues(PDO $pdo, string $table, string $column): array
{
    // information_schema is used instead of "SHOW COLUMNS ... LIKE :column"
    // because SHOW statements don't support bound placeholders under
    // native (non-emulated) prepared statements on MySQL/MariaDB.
    $stmt = $pdo->prepare("
        SELECT COLUMN_TYPE
        FROM information_schema.COLUMNS
        WHERE TABLE_SCHEMA = DATABASE()
          AND TABLE_NAME = :table
          AND COLUMN_NAME = :column
        LIMIT 1
    ");
    $stmt->execute([':table' => $table, ':column' => $column]);

    $columnType = $stmt->fetchColumn();

    if (!$columnType || !preg_match("/^enum\((.*)\)$/i", $columnType, $matches)) {
        return [];
    }

    return str_getcsv($matches[1], ',', "'");
}

/*
|--------------------------------------------------------------------------
| Booking Conflict Detection
|--------------------------------------------------------------------------
*/

/**
 * Check if a room has an existing 'Pending' or 'Approved' booking that overlaps
 * with the requested date and time interval.
 *
 * @param PDO      $pdo
 * @param int      $roomId
 * @param string   $date               Date string in Y-m-d format
 * @param string   $startTime          Time string in H:i format
 * @param string   $endTime            Time string in H:i format
 * @param int|null $excludeBookingId   Optional booking ID to ignore (useful when updating an existing booking)
 * @return bool    True if a conflict exists, false otherwise
 */
function hasBookingConflict(
    PDO $pdo,
    int $roomId,
    string $date,
    string $startTime,
    string $endTime,
    ?int $excludeBookingId = null
): bool {

    $sql = "
        SELECT COUNT(*) FROM bookings
        WHERE room_id = :room_id
          AND date = :date
          AND status IN ('Pending', 'Approved')
          AND start_time < :end_time
          AND end_time > :start_time
    ";

    $params = [
        ':room_id'    => $roomId,
        ':date'       => $date,
        ':start_time' => $startTime,
        ':end_time'   => $endTime,
    ];

    if ($excludeBookingId !== null) {
        $sql .= " AND id != :exclude_id";
        $params[':exclude_id'] = $excludeBookingId;
    }

    $stmt = $pdo->prepare($sql);
    $stmt->execute($params);

    return (int) $stmt->fetchColumn() > 0;
}

/*
|--------------------------------------------------------------------------
| Date / Time Format Validation
|--------------------------------------------------------------------------
*/

/**
 * Validate that a date string strictly matches YYYY-MM-DD.
 */
function isValidDate(string $date): bool
{
    $d = DateTime::createFromFormat('Y-m-d', $date);
    return $d !== false && $d->format('Y-m-d') === $date;
}

/**
 * Validate that a time string strictly matches HH:MM (24-hour format).
 */
function isValidTime(string $time): bool
{
    $t = DateTime::createFromFormat('H:i', $time);
    return $t !== false && $t->format('H:i') === $time;
}

/*
|--------------------------------------------------------------------------
| Booking Lifecycle
|--------------------------------------------------------------------------
*/

/**
 * Flip any 'Approved' booking whose end date/time has already passed
 * to 'Completed'. Called on booking-listing pages rather than via a
 * cron job — the system has no scheduled task runner, so this "lazy"
 * transition on page load is the simplest way to keep statuses honest
 * without one. Safe to call repeatedly; only touches rows that qualify.
 */
function autoCompletePastBookings(PDO $pdo): void
{
    $pdo->exec("
        UPDATE bookings
        SET status = 'Completed', updated_at = NOW()
        WHERE status = 'Approved'
          AND (date < CURDATE() OR (date = CURDATE() AND end_time <= CURTIME()))
    ");
}

/*
|--------------------------------------------------------------------------
| CSRF Protection
|--------------------------------------------------------------------------
*/

function generateCsrfToken(): string
{
    if (empty($_SESSION['csrf_token'])) {
        $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
    }

    return $_SESSION['csrf_token'];
}

function verifyCsrfToken(?string $token): bool
{
    return isset($_SESSION['csrf_token'])
        && $token !== null
        && hash_equals($_SESSION['csrf_token'], $token);
}

/*
|--------------------------------------------------------------------------
| Flash Messages
|--------------------------------------------------------------------------
*/

function setFlash(string $type, string $message): void
{
    $_SESSION['flash'][$type] = $message;
}

function getFlash(): array
{
    $flash = $_SESSION['flash'] ?? [];
    unset($_SESSION['flash']);

    return $flash;
}
