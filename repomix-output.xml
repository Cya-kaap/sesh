        FROM bookings b
        JOIN rooms r
            ON b.room_id = r.id
        JOIN users u
            ON b.user_id = u.id
        JOIN programmes p
            ON b.programme_id = p.id
        JOIN semesters s
            ON b.semester_id = s.id
        ORDER BY b.date DESC, b.start_time DESC
    ");

